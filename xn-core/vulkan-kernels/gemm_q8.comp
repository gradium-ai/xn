#version 450
// q8_0 dequantize-fused GEMM for small m (2..=16): a few rows of activations
// against 8-bit weights.
//   dst[i, j] = sum_l lhs[i, l] * W[j, l],  W held as q8_0 blocks.
// Grid: (ceil(n/TN), ceil(m/MR), 1); local size TPB.
//
// A port of webgpu-kernels/gemm_q8.wgsl. Same weight layout and the same
// reduction shape as gemv_q8.comp; the difference is that a workgroup covers
// MR rows as well as TN columns, so one pass over the weight stream serves MR
// outputs instead of one. `m == 1` is deliberately not routed here: sending
// single-row work through a 4-row tile pays four times the reduction for one
// useful result.
//
// Rows past `m` and columns past `n` are clamped onto the last valid one and
// discarded at store time, since Vulkan storage reads are not bounds-checked.
layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) writeonly buffer D { float dst[]; };
layout(std430, set = 0, binding = 1) readonly buffer L { vec4 lhs4[]; };
layout(std430, set = 0, binding = 2) readonly buffer Q { uint qs[]; };
layout(std430, set = 0, binding = 3) readonly buffer S { float scales[]; };

layout(push_constant) uniform PC {
    uint m;
    uint n;
    uint k;
} pc;

const uint TPB = 64u;   // threads per workgroup, matches local_size_x
const uint TN = 4u;     // output columns per workgroup
const uint MR = 4u;     // output rows per workgroup
const uint ACC = 16u;   // MR * TN

shared float sh[TPB * ACC];

vec4 unpack4(uint w) {
    int q = int(w);
    return vec4(
        float(bitfieldExtract(q, 0, 8)),
        float(bitfieldExtract(q, 8, 8)),
        float(bitfieldExtract(q, 16, 8)),
        float(bitfieldExtract(q, 24, 8)));
}

void main() {
    uint j0 = gl_WorkGroupID.x * TN;
    uint i0 = gl_WorkGroupID.y * MR;
    uint tid = gl_LocalInvocationID.x;

    uint kw = pc.k >> 2u;   // packed words per row
    uint kb = pc.k >> 5u;   // blocks per row

    uint jl = pc.n - 1u;
    uint c0 = min(j0 + 0u, jl);
    uint c1 = min(j0 + 1u, jl);
    uint c2 = min(j0 + 2u, jl);
    uint c3 = min(j0 + 3u, jl);
    uint q0 = c0 * kw;
    uint q1 = c1 * kw;
    uint q2 = c2 * kw;
    uint q3 = c3 * kw;
    uint s0 = c0 * kb;
    uint s1 = c1 * kb;
    uint s2 = c2 * kb;
    uint s3 = c3 * kb;

    // Row bases into lhs, in vec4 units.
    uint il = pc.m - 1u;
    uint r0 = min(i0 + 0u, il) * kw;
    uint r1 = min(i0 + 1u, il) * kw;
    uint r2 = min(i0 + 2u, il) * kw;
    uint r3 = min(i0 + 3u, il) * kw;

    float a00 = 0.0, a01 = 0.0, a02 = 0.0, a03 = 0.0;
    float a10 = 0.0, a11 = 0.0, a12 = 0.0, a13 = 0.0;
    float a20 = 0.0, a21 = 0.0, a22 = 0.0, a23 = 0.0;
    float a30 = 0.0, a31 = 0.0, a32 = 0.0, a33 = 0.0;

    for (uint w = tid; w < kw; w += TPB) {
        uint bi = w >> 3u;

        vec4 w0 = unpack4(qs[q0 + w]);
        vec4 w1 = unpack4(qs[q1 + w]);
        vec4 w2 = unpack4(qs[q2 + w]);
        vec4 w3 = unpack4(qs[q3 + w]);
        float d0 = scales[s0 + bi];
        float d1 = scales[s1 + bi];
        float d2 = scales[s2 + bi];
        float d3 = scales[s3 + bi];

        vec4 x0 = lhs4[r0 + w];
        a00 = fma(d0, dot(w0, x0), a00);
        a01 = fma(d1, dot(w1, x0), a01);
        a02 = fma(d2, dot(w2, x0), a02);
        a03 = fma(d3, dot(w3, x0), a03);

        vec4 x1 = lhs4[r1 + w];
        a10 = fma(d0, dot(w0, x1), a10);
        a11 = fma(d1, dot(w1, x1), a11);
        a12 = fma(d2, dot(w2, x1), a12);
        a13 = fma(d3, dot(w3, x1), a13);

        vec4 x2 = lhs4[r2 + w];
        a20 = fma(d0, dot(w0, x2), a20);
        a21 = fma(d1, dot(w1, x2), a21);
        a22 = fma(d2, dot(w2, x2), a22);
        a23 = fma(d3, dot(w3, x2), a23);

        vec4 x3 = lhs4[r3 + w];
        a30 = fma(d0, dot(w0, x3), a30);
        a31 = fma(d1, dot(w1, x3), a31);
        a32 = fma(d2, dot(w2, x3), a32);
        a33 = fma(d3, dot(w3, x3), a33);
    }

    uint o = tid * ACC;
    sh[o +  0u] = a00; sh[o +  1u] = a01; sh[o +  2u] = a02; sh[o +  3u] = a03;
    sh[o +  4u] = a10; sh[o +  5u] = a11; sh[o +  6u] = a12; sh[o +  7u] = a13;
    sh[o +  8u] = a20; sh[o +  9u] = a21; sh[o + 10u] = a22; sh[o + 11u] = a23;
    sh[o + 12u] = a30; sh[o + 13u] = a31; sh[o + 14u] = a32; sh[o + 15u] = a33;
    barrier();
    for (uint s = TPB >> 1u; s > 0u; s >>= 1u) {
        if (tid < s) {
            uint a = tid * ACC;
            uint b = (tid + s) * ACC;
            for (uint c = 0u; c < ACC; c++) {
                sh[a + c] += sh[b + c];
            }
        }
        barrier();
    }
    // ACC results live in sh[0..16); one thread per (row, column) stores.
    if (tid < ACC) {
        uint rr = tid / TN;
        uint cc = tid % TN;
        uint ii = i0 + rr;
        uint jj = j0 + cc;
        if (ii < pc.m && jj < pc.n) {
            dst[ii * pc.n + jj] = sh[tid];
        }
    }
}
