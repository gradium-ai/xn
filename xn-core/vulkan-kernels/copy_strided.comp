#version 450
#include "dtype.glsl"
// Copy from a strided source to a contiguous destination.
// The push constants carry [dims (num_dims), src_strides (num_dims)] for up
// to MAXD dims, so no side buffer has to be allocated and uploaded per call
// and the per-element index walk reads uniforms rather than global memory.
layout(local_size_x = 256) in;

#define MAXD 8

layout(std430, set = 0, binding = 0) buffer S { SCALAR src[]; };
layout(std430, set = 0, binding = 1) buffer D { SCALAR dst[]; };

layout(push_constant) uniform PC {
    uint numel;
    uint num_dims;
    uint src_offset;
    uint info[2 * MAXD];
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.numel) return;
    uint nd = pc.num_dims;
    uint si = 0u;
    uint rem = idx;
    for (uint d = 0u; d < nd; d++) {
        uint di = nd - 1u - d;
        uint dimv = pc.info[di];
        si += (rem % dimv) * pc.info[nd + di];
        rem /= dimv;
    }
    dst[idx] = src[pc.src_offset + si];
}
